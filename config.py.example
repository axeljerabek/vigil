import os
import logging
import json
import urllib.request

# ==============================================================================
# IDENTITY-GUARD PRO - PRODUCTION CONFIGURATION (PORTABLE & STABLE)
# ==============================================================================

# AUTOMATISCHE PFAD-ERKENNUNG: Findet den Projektordner selbstständig.
PROJECT_ROOT = os.path.dirname(os.path.abspath(__file__))

# UMSCHALTUNG DER YOLO-VERSION ("v10", "v12" oder "v26") und MODELLGRÖSSE ("n", "s", "m", "b", "l", "x")
YOLO_VERSION = "v26"
MODEL_SIZE   = "x"  # Wähle: "n", "s", "m", "b" (nur v10), "l", "x"

# Dynamische Dateinamen und Download-URLs generieren
if YOLO_VERSION == "v26":
    # YOLO26 unterstützt: n, s, m, l, x
    if MODEL_SIZE not in ["n", "s", "m", "l", "x"]:
        MODEL_SIZE = "x"  # Fallback
    MODEL_FILENAME = f"yolo26{MODEL_SIZE}.pt"
    YOLO_URL = f"https://github.com/ultralytics/assets/releases/download/v8.4.0/yolo26{MODEL_SIZE}.pt"
elif YOLO_VERSION == "v12":
    # YOLOv12 unterstützt: n, s, m, l, x
    if MODEL_SIZE not in ["n", "s", "m", "l", "x"]:
        MODEL_SIZE = "x"  # Fallback
    MODEL_FILENAME = f"yolo12{MODEL_SIZE}.pt"
    YOLO_URL = f"https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo12{MODEL_SIZE}.pt"
else:
    # YOLOv10 unterstützt: n, s, m, b, l, x
    if MODEL_SIZE not in ["n", "s", "m", "b", "l", "x"]:
        MODEL_SIZE = "x"  # Fallback
    MODEL_FILENAME = f"yolov10{MODEL_SIZE}.pt"
    YOLO_URL = f"https://github.com/THU-MIG/yolov10/releases/download/v1.1/yolov10{MODEL_SIZE}.pt"

# Alle Pfade werden relativ zum Projektordner berechnet
ALERTS_DIR      = os.path.join(PROJECT_ROOT, "alerts")
LOG_DIR         = os.path.join(PROJECT_ROOT, "logs")
MODEL_PATH      = os.path.join(PROJECT_ROOT, MODEL_FILENAME)
OVERRIDE_F      = os.path.join(PROJECT_ROOT, "stream_overrides.json")
SETTINGS_F      = os.path.join(PROJECT_ROOT, "pipeline_settings.json")

# Web-UI Pipeline Settings frühzeitig laden, falls Version oder Größe überschrieben werden
if os.path.exists(SETTINGS_F):
    try:
        with open(SETTINGS_F, 'r') as f:
            sett = json.load(f)
            if 'YOLO_VERSION' in sett:
                YOLO_VERSION = sett['YOLO_VERSION']
            if 'MODEL_SIZE' in sett:
                MODEL_SIZE = sett['MODEL_SIZE']

            # Erneut auflösen nach Settings-Laden
            if YOLO_VERSION == "v26":
                if MODEL_SIZE not in ["n", "s", "m", "l", "x"]: MODEL_SIZE = "x"
                MODEL_FILENAME = f"yolo26{MODEL_SIZE}.pt"
                YOLO_URL = f"https://github.com/ultralytics/assets/releases/download/v8.4.0/yolo26{MODEL_SIZE}.pt"
            elif YOLO_VERSION == "v12":
                if MODEL_SIZE not in ["n", "s", "m", "l", "x"]: MODEL_SIZE = "x"
                MODEL_FILENAME = f"yolo12{MODEL_SIZE}.pt"
                YOLO_URL = f"https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo12{MODEL_SIZE}.pt"
            else:
                if MODEL_SIZE not in ["n", "s", "m", "b", "l", "x"]: MODEL_SIZE = "x"
                MODEL_FILENAME = f"yolov10{MODEL_SIZE}.pt"
                YOLO_URL = f"https://github.com/THU-MIG/yolov10/releases/download/v1.1/yolov10{MODEL_SIZE}.pt"

            MODEL_PATH = os.path.join(PROJECT_ROOT, MODEL_FILENAME)

            # ALERTS_DIR_OVERRIDE: Aufnahmen auf ein anderes Laufwerk umleiten
            # (z.B. eine große externe Platte statt der Systemplatte, auf der
            # das Projekt selbst liegt). Bewusst mit striktem Fallback auf den
            # Standard-Pfad bei JEDEM Problem -- config.py wird von JEDEM
            # Prozess importiert (Master, jeder Kamera-Worker, web_ui.py),
            # ein kaputter/nicht existierender/nicht beschreibbarer Override
            # würde sonst die gesamte Pipeline lahmlegen, nicht nur die
            # Aufnahme-Funktion. Ändert NICHTS an bereits existierenden
            # Aufnahmen im alten Ordner -- die bleiben dort liegen, nur neue
            # Aufnahmen landen ab dem nächsten Pipeline-Neustart im neuen Pfad.
            alerts_override = (sett.get('ALERTS_DIR_OVERRIDE') or '').strip()
            if alerts_override:
                if not os.path.isabs(alerts_override):
                    print(f"⚠️ ALERTS_DIR_OVERRIDE muss ein absoluter Pfad sein, ignoriere: {alerts_override}")
                else:
                    try:
                        os.makedirs(alerts_override, exist_ok=True)
                        test_file = os.path.join(alerts_override, ".vigil_write_test")
                        with open(test_file, 'w') as tf:
                            tf.write("ok")
                        os.remove(test_file)
                        ALERTS_DIR = alerts_override
                    except Exception as e:
                        print(f"⚠️ ALERTS_DIR_OVERRIDE '{alerts_override}' nicht beschreibbar, bleibe beim Standard-Pfad: {e}")
    except Exception as e:
        print(f"Pipeline Settings Vorab-Lese-Fehler: {e}")

# AUTO-DOWNLOAD: Falls das gewählte Modell im Projektordner fehlt.
#
# WICHTIG: config.py wird von mehreren Prozessen gleichzeitig importiert
# (Master + jeder Kamera-Worker + web_ui.py) — ohne die folgenden Absicherungen
# könnten mehrere Prozesse beim allerersten Start gleichzeitig in dieselbe
# .pt-Datei schreiben und sie gegenseitig korrumpieren. Ultralytics selbst hat
# genau dieses Problem für YOLO26-Checkpoints in einer späteren Paket-Version
# als bekannten Bug gefixt (konkurrierendes *Laden*); hier geht es zusätzlich
# um konkurrierendes *Herunterladen*, was dieselbe Absicherung braucht:
#   1. Download in eine prozess-eigene Temp-Datei (kein gemeinsamer Schreib-Pfad)
#   2. Timeout, damit ein hängender Download nicht den ganzen Prozessstart blockiert
#   3. Größen-Sanity-Check (eine echte .pt-Datei ist mehrere MB groß — ein paar
#      KB deuten auf eine HTML-Fehlerseite statt eines echten Modells hin)
#   4. Direkt vor dem finalen Umbenennen nochmal prüfen, ob ein anderer Prozess
#      inzwischen bereits fertig heruntergeladen hat (dann einfach verwerfen)
#   5. os.replace() ist auf demselben Dateisystem atomar — kein Prozess sieht
#      je eine halb geschriebene Datei
MODEL_MIN_BYTES = 1_000_000  # 1 MB — großzügige Untergrenze, jedes echte YOLO-.pt ist deutlich größer

if not os.path.exists(MODEL_PATH) or os.path.getsize(MODEL_PATH) < MODEL_MIN_BYTES:
    # Größen-Check hier (nicht nur nach dem Download) ist bewusst: eine leere
    # oder unvollständige Datei soll als "muss heruntergeladen werden" zählen.
    # Wichtig z.B. für Docker-Bind-Mounts — mountet man einen Host-Pfad, der
    # noch nicht existiert, auf eine einzelne Datei, würde Docker sonst ein
    # Verzeichnis anlegen; per `touch` vorab als leere Datei angelegt, würde
    # ein reiner Existenz-Check den Download fälschlich überspringen.
    print(f"📥 Modell '{MODEL_FILENAME}' (YOLO {YOLO_VERSION} - {MODEL_SIZE}) nicht gefunden. Lade herunter...")
    tmp_path = f"{MODEL_PATH}.part-{os.getpid()}"
    try:
        with urllib.request.urlopen(YOLO_URL, timeout=30) as resp, open(tmp_path, 'wb') as out:
            while True:
                chunk = resp.read(1024 * 256)
                if not chunk:
                    break
                out.write(chunk)

        downloaded_size = os.path.getsize(tmp_path)
        if downloaded_size < MODEL_MIN_BYTES:
            raise ValueError(
                f"Heruntergeladene Datei verdächtig klein ({downloaded_size} Bytes) — "
                f"vermutlich keine gültige Modelldatei (falsche URL / Fehlerseite?)."
            )

        if not os.path.exists(MODEL_PATH) or os.path.getsize(MODEL_PATH) < MODEL_MIN_BYTES:
            os.replace(tmp_path, MODEL_PATH)  # atomar, kein Prozess sieht eine halbe Datei
            print("✅ YOLO-Modell erfolgreich heruntergeladen.")
        else:
            # Ein paralleler Prozess war schneller fertig (echte Datei, nicht nur
            # eine leere touch-Datei) — unsere Kopie verwerfen.
            os.remove(tmp_path)
            print("ℹ️ Modell wurde inzwischen von einem anderen Prozess fertig heruntergeladen.")
    except Exception as e:
        print(f"❌ Fehler beim automatischen Download des YOLO-Modells: {e}")
    finally:
        if os.path.exists(tmp_path):
            try:
                os.remove(tmp_path)
            except OSError:
                pass

# Stream Configuration: bevorzugt aus streams.json (per Dashboard-GUI
# verwaltet, siehe Settings -> Cameras) — kein Bearbeiten dieser Datei mehr
# nötig, um Kameras hinzuzufügen/zu entfernen. Der Platzhalter unten greift
# nur, wenn noch keine streams.json existiert (frische Installation, bevor
# im Dashboard das erste Mal gespeichert wurde).
STREAMS_F = os.path.join(PROJECT_ROOT, "streams.json")

STREAMS = [
    {"name": "Example_Camera", "url": "rtmp://192.168.1.50/live/stream", "enabled": False, "audio_enabled": True, "type": "VIDEO"}
]
if os.path.exists(STREAMS_F):
    try:
        with open(STREAMS_F, 'r') as f:
            loaded_streams = json.load(f)
        if isinstance(loaded_streams, list) and loaded_streams:
            STREAMS = loaded_streams
    except Exception as e:
        print(f"Streams-Konfigurationsfehler: {e}")

# WICHTIG: stream_overrides.json NIEMALS in "enabled" mischen. overrides.json
# ist ausschließlich die Dashboard-eigene Live-Vorschau-Pause (rein
# kosmetisch, betrifft nur ob die Kachel im Dashboard ein Bild zeigt) — ein
# komplett separates Konzept von "enabled" (steuert, ob überhaupt ein
# CameraAgent-Prozess gestartet wird UND aufnimmt, siehe run_pipeline()
# weiter unten: "if stream.get('enabled', False):"). Diese Datei hatte
# genau diese Vermischung früher hier — eine im Dashboard abgewählte Kamera
# (streams.json korrekt enabled=False) bekam trotzdem einen Prozess, weil
# der (meist auf "ON" stehende) Vorschau-Override das enabled-Feld wieder
# auf True zurückgesetzt hat, BEVOR der Spawn-Loop überhaupt lief. Derselbe
# Fehler wurde in web_ui.py (_load_streams_display, reine Anzeige) schon
# einmal gefunden und behoben — hier war die Ursache für tatsächlich
# unerwünscht laufende Aufnahme-Prozesse.

# Standard Processing Parameters
