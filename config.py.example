}

# Web-UI Pipeline Settings vollständig anwenden
if os.path.exists(SETTINGS_F):
    try:
        with open(SETTINGS_F, 'r') as f:
            sett = json.load(f)
            PRE_ROLL_SEC = int(sett.get('PRE_ROLL_SEC', PRE_ROLL_SEC))
            POST_ROLL_SEC = int(sett.get('POST_ROLL_SEC', POST_ROLL_SEC))
            TARGET_FPS = int(sett.get('TARGET_FPS', TARGET_FPS))
            CONFIDENCE_THRESHOLD = float(sett.get('CONFIDENCE_THRESHOLD', CONFIDENCE_THRESHOLD))
            if 'DETECTION_CLASSES' in sett:
                DETECTION_CLASSES = [int(c) for c in sett['DETECTION_CLASSES']]
    except Exception as e:
        print(f"Pipeline Settings Fehler: {e}")

# Sanity-Clamping: schützt vor Bugs weiter unten (z.B. Division durch 0 bei
# frame_interval = 1.0/TARGET_FPS in recorder_pipeline.py), falls die
# Settings-Datei mal von Hand editiert oder anderweitig korrumpiert wurde.
# web_ui.py clamped beim Speichern bereits selbst — das hier ist nur das
# zweite Sicherheitsnetz für den Fall eines manuellen/externen Edits.
if TARGET_FPS <= 0:
    TARGET_FPS = 30
if PRE_ROLL_SEC < 0:
    PRE_ROLL_SEC = 0
if POST_ROLL_SEC < 0:
    POST_ROLL_SEC = 0
if not (0.0 < CONFIDENCE_THRESHOLD <= 1.0):
    CONFIDENCE_THRESHOLD = 0.5
if not DETECTION_CLASSES:
    DETECTION_CLASSES = [0]

# Recording Mode
RECORDING_MODE = "EVENT_DRIVEN"

# Sicherstellen, dass die Ordner im Projektverzeichnis existieren
os.makedirs(ALERTS_DIR, exist_ok=True)
os.makedirs(LOG_DIR, exist_ok=True)

def get_stream_logger(stream_name):
    logger = logging.getLogger(f"vigil.{stream_name}")
    if not logger.handlers:
        logger.setLevel(logging.INFO)
        log_file = os.path.join(LOG_DIR, f"{stream_name}.log")
        fh = logging.FileHandler(log_file); fh.setLevel(logging.INFO)
        ch = logging.StreamHandler(); ch.setLevel(logging.INFO)
        formatter = logging.Formatter("%(asctime)s - %(levelname)s - %(message)s")
        fh.setFormatter(formatter); ch.setFormatter(formatter)
        logger.addHandler(fh); logger.addHandler(ch)
    return logger

# System Logger Setup
system_logger = logging.getLogger("vigil.SYSTEM")
system_logger.setLevel(logging.INFO)
if not system_logger.handlers:
    s_log_file = os.path.join(LOG_DIR, "system_main.log")
    sh = logging.FileHandler(s_log_file); sh.setLevel(logging.INFO)
    formatter = logging.Formatter("%(asctime)s - [%(levelname)s] - %(message)s")
    sh.setFormatter(formatter); system_logger.addHandler(sh)

def global_log(msg, level="info"):
    if level == "info": system_logger.info(msg)
    elif level == "error": system_logger.error(msg)
    elif level == "warning": system_logger.warning(msg)
